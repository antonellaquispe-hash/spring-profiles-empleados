{
  "info": {
    "name": "Empleados Spring Profiles",
    "description": "CRUD y consulta de configuración. Cambia la variable baseUrl según el perfil activo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "empleadoId", "value": "1" }
  ],
  "item": [
    { "name": "Configuración activa", "request": { "method": "GET", "url": "{{baseUrl}}/configuracion" } },
    { "name": "Crear empleado", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"Pérez\",\n  \"email\": \"ana@example.com\",\n  \"sueldo\": 2500.00\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/empleados" } },
    { "name": "Listar empleados", "request": { "method": "GET", "url": "{{baseUrl}}/empleados" } },
    { "name": "Consultar empleado", "request": { "method": "GET", "url": "{{baseUrl}}/empleados/{{empleadoId}}" } },
    { "name": "Actualizar empleado", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombres\": \"Ana María\",\n  \"apellidos\": \"Pérez\",\n  \"email\": \"ana@example.com\",\n  \"sueldo\": 2700.00\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/empleados/{{empleadoId}}" } },
    { "name": "Eliminar empleado", "request": { "method": "DELETE", "url": "{{baseUrl}}/empleados/{{empleadoId}}" } }
  ]
}
